<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liugh.mapper.RCSCdrInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.liugh.entity.RCSCdrInfo">
        <result column="id" property="id" />
        <result column="ssid" property="ssid" />
        <result column="status" property="status" />
        <result column="content" property="content" />
        <result column="msisdn" property="msisdn" />
        <result column="msg_id" property="msgId" />
        <result column="sender" property="sender" />
        <result column="province" property="province" />
        <result column="city" property="city" />
        <result column="msg_type" property="msgType" />
        <result column="timemark" property="timemark" />
        <result column="create_time" property="createTime" />
        <result column="retry_count" property="retryCount" />
        <result column="rssid" property="rssid" />
        <result column="receive_time" property="receiveTime" />
        <result column="expire_time" property="expireTime" />
        <result column="thumbnail" property="thumbnail" />
        <result column="suggestions" property="suggestions" />
        <result column="cost" property="cost" />
        <result column="channel_code" property="channelCode" />
        <result column="channel_msg_id" property="channelMsgId" />
        <result column="country_code" property="countryCode" />
        <result column="traffic_type" property="trafficType" />
        <result column="billing_category" property="billingCategory" />
        <result column="currency" property="currency" />
        <result column="delivered_time" property="deliveredTime" />
        <result column="read_time" property="readTime" />
        <result column="error_code" property="errorCode" />
        <result column="error_reason" property="errorReason" />
    </resultMap>

    <select id="existTable" parameterType="String" resultType="Integer">
        select count(*)
        from information_schema.TABLES
        where LCASE(table_name)=#{tableName}
    </select>

    <update id="dropTable">
        DROP TABLE IF EXISTS ${tableName}
    </update>

    <update id="createNewTable" parameterType="String">
        CREATE TABLE ${tableName} (
          `id` bigint(20) NOT NULL AUTO_INCREMENT,
          `ssid` int(11) NOT NULL DEFAULT '0',
          `rssid` int(11) NOT NULL DEFAULT '0',
          `status` int(11) NOT NULL DEFAULT '-1',
          `content` varchar(10240) NOT NULL DEFAULT '',
          `msisdn` varchar(64) DEFAULT '',
          `msg_id` varchar(64) DEFAULT '',
          `sender` varchar(64) DEFAULT '',
          `province` varchar(50) DEFAULT NULL,
          `city` varchar(50) DEFAULT '',
          `msg_type` varchar(16) DEFAULT '',
          `receive_time` varchar(50) DEFAULT '',
          `create_time` bigint(20) DEFAULT NULL,
          `retry_count` int(11) NOT NULL DEFAULT '0',
          `expire_time` bigint(20) DEFAULT NULL,
          `timemark` varchar(50) DEFAULT NULL,
          `thumbnail` varchar(512) DEFAULT NULL,
          `suggestions` text,
          `cost` varchar(32) DEFAULT NULL,
          `channel_code` varchar(32) DEFAULT NULL,
          `channel_msg_id` varchar(128) DEFAULT NULL,
          `country_code` varchar(8) DEFAULT NULL,
          `traffic_type` varchar(24) DEFAULT NULL,
          `billing_category` varchar(24) DEFAULT NULL,
          `currency` varchar(8) DEFAULT NULL,
          `delivered_time` bigint(20) DEFAULT NULL,
          `read_time` bigint(20) DEFAULT NULL,
          `error_code` varchar(64) DEFAULT NULL,
          `error_reason` varchar(512) DEFAULT NULL,
          PRIMARY KEY (`id`),
          KEY `idx_channel_msgid` (`channel_msg_id`),
          KEY `idx_ssid_time` (`ssid`,`create_time`,`status`),
          KEY `idx_msisdn` (`msisdn`)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    </update>

    <insert id="insertCdr">
        insert into ${tableName}
        (`ssid`, `rssid`, `status`, `content`, `msisdn`, `msg_id`, `sender`,
        `province`, `city`, `msg_type`, `receive_time`, `create_time`, `expire_time`,
        `timemark`, `retry_count`, `thumbnail`, `suggestions`, `cost`,
        `channel_code`, `channel_msg_id`, `country_code`, `traffic_type`,
        `billing_category`, `currency`, `delivered_time`, `read_time`,
        `error_code`, `error_reason`)
        values
        (#{cdr.ssid}, #{cdr.rssid}, #{cdr.status}, #{cdr.content}, #{cdr.msisdn},
        #{cdr.msgId}, #{cdr.sender}, #{cdr.province}, #{cdr.city}, #{cdr.msgType},
        #{cdr.receiveTime}, #{cdr.createTime}, #{cdr.expireTime}, #{cdr.timemark},
        #{cdr.retryCount}, #{cdr.thumbnail}, #{cdr.suggestions}, #{cdr.cost},
        #{cdr.channelCode}, #{cdr.channelMsgId}, #{cdr.countryCode}, #{cdr.trafficType},
        #{cdr.billingCategory}, #{cdr.currency}, #{cdr.deliveredTime}, #{cdr.readTime},
        #{cdr.errorCode}, #{cdr.errorReason})
    </insert>

</mapper>
