<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liugh.mapper.RoutingInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.liugh.entity.RoutingInfo">
        <result column="id" property="id" />
        <result column="type" property="type" />
        <result column="ossid" property="ossid" />
        <result column="rssid" property="rssid" />
        <result column="country_code" property="countryCode" />
        <result column="sender" property="sender" />
        <result column="content_keyword_id" property="contentKeywordId" />
        <result column="content_template_id" property="contentTemplateId" />
        <result column="ratio" property="ratio" />
        <result column="status" property="status" />
    </resultMap>
    
    <resultMap id="byFiledId" type="java.util.Map">
		  <result column="country_code" property="countryCode" />
	</resultMap>


    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, type, ossid, rssid, ratio, status, country_code AS countryCode, sender, content_keyword_id AS contentKeywordId, content_template_id AS contentTemplateId
    </sql>
    
    <select id="groupByCountryCode"  resultType="Map">
        select country_code as countryCode from routing_info where ossid=#{ossid} and type=#{type} group by country_code
    </select>

</mapper>
